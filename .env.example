# ============================================================================
#  ms-cad-user — Configuração por ambiente (12-factor)
#  Copie este arquivo para `.env` e ajuste conforme o seu ambiente:
#      cp .env.example .env
#
#  IMPORTANTE — dois contextos de execução:
#   1) docker-compose → usa a REDE INTERNA do compose (kafka:9092,
#      mongodb:27017). O compose lê daqui portas, tópicos e tuning.
#   2) `go run` no HOST (ex.: make load) → usa as portas publicadas
#      no host (KAFKA_BROKERS=localhost:9095, MONGODB_URI=mongodb://localhost:27017).
# ============================================================================

# ----- Portas mapeadas no host (evite conflitos locais) ---------------------
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
KAFKA_PORT=9095
KAFKA_UI_PORT=9085

# ----- Kafka: tópicos, partições e consumer group --------------------------
KAFKA_TOPIC=cad-user.created
KAFKA_TOPIC_DLQ=cad-user.dlq
KAFKA_TOPIC_PARTITIONS=6
KAFKA_TOPIC_REPLICAS=1
KAFKA_CONSUMER_GROUP=cad-user-worker

# ----- Execução no HOST (go run / make load) --------------------------------
# Valores literais de propósito: o `.env` também é usado via `source .env`.
KAFKA_BROKERS=localhost:9095
MONGODB_URI=mongodb://localhost:27017

# ----- MongoDB (nome do banco/coleção usados pela aplicação) ----------------
MONGO_DATABASE=cad_user
MONGO_COLLECTION=users

# ----- Worker consumer (tuning de lote) --------------------------------------
WORKER_BATCH_SIZE=1000
WORKER_FLUSH_INTERVAL=1s
WORKER_RETRY_MAX=5

# ----- Generator (carga em massa) --------------------------------------------
LOAD_TOTAL=500000
LOAD_RATE=2000
